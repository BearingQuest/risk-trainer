{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh * pr merge)",
      "Bash(gh * pr merge *)",
      "Bash(bq-merge)",
      "Bash(bq-merge *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git * push * --force*)",
      "Bash(git * push * -f*)",
      "Bash(git * push * +*)",
      "Bash(rm -rf)",
      "Bash(rm -rf *)",
      "Bash(rm -fr)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r)",
      "Bash(rm -f -r *)",
      "Bash(rm -Rf)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR)",
      "Bash(rm -fR *)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *actions/permissions*)",
      "Bash(gh api *code-security*)",
      "Bash(gh api *environments*)",
      "Bash(gh api *actions/secrets*)",
      "Bash(gh api *pages*)",
      "Bash(gh secret)",
      "Bash(gh secret *)",
      "Bash(gh repo create)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit)",
      "Bash(gh repo edit *)",
      "Bash(gh release)",
      "Bash(gh release *)",
      "Bash(gh * release create)",
      "Bash(gh * release create *)",
      "Bash(gh * release edit)",
      "Bash(gh * release edit *)",
      "Bash(gh * release delete)",
      "Bash(gh * release delete *)",
      "Bash(gh * release upload)",
      "Bash(gh * release upload *)",
      "Bash(git tag)",
      "Bash(git tag *)",
      "Bash(git * tag)",
      "Bash(git * tag *)",
      "Bash(git push *--tags*)",
      "Bash(git * push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git * push *--follow-tags*)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform * apply)",
      "Bash(terraform * apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(terraform * destroy)",
      "Bash(terraform * destroy *)",
      "Bash(rt approve)",
      "Bash(rt approve *)",
      "Bash(rt retire)",
      "Bash(rt retire *)",
      "Bash(uv run rt approve)",
      "Bash(uv run rt approve *)",
      "Bash(uv run rt retire)",
      "Bash(uv run rt retire *)",
      "Bash(uv run * rt approve)",
      "Bash(uv run * rt approve *)",
      "Bash(uv run * rt retire)",
      "Bash(uv run * rt retire *)",
      "Bash(gh auth token*)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh auth status *-t*)",
      "Read(~/.ai_post_env)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/career-workspace/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(//Library/Application Support/ClaudeCode/**)",
      "Edit(/infra/bootstrap/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(gh pr)",
      "Bash(gh pr *)",
      "Bash(gh * pr)",
      "Bash(gh * pr *)",
      "Bash(gh api)",
      "Bash(gh api *)",
      "Bash(gh * api)",
      "Bash(gh * api *)",
      "Bash(python3)",
      "Bash(python3 *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "gh *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ai_post_env",
        "~/.aws",
        "~/.ssh",
        "~/.config/gh",
        "~/career-workspace",
        "./.env",
        "./.env.*"
      ],
      "denyWrite": [
        "./.claude/settings.json",
        "./.claude/settings.local.json",
        "~/.claude/settings.json",
        "/Library/Application Support/ClaudeCode",
        "./infra/bootstrap"
      ],
      "allowWrite": [
        "~/.cache/uv"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "api.github.com"
      ],
      "allowLocalBinding": true
    }
  }
}
